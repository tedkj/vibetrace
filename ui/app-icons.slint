// VibeTrace's own icons, on the VibeWare 16-unit grid (1-unit strokes, 0/45/90 degrees,
// axis-aligned strokes on half units). The shared set lives in @vibeware.

export global AppIcons {
    // Trace: a play mark, its slanted sides at 45 degrees.
    out property <string> play: "M 5.5 3.5 L 10.5 8.5 L 5.5 13.5 Z";
    // Save report: a sheet with the download arrow.
    out property <string> save: "M 3.5 1.5 L 9.5 1.5 L 12.5 4.5 L 12.5 14.5 L 3.5 14.5 Z M 8.5 6 L 8.5 12 M 6 9.5 L 8.5 12 L 11 9.5";
    // ISP log: a strip chart, the line running on with a drop in it.
    out property <string> log: "M 1.5 2.5 L 1.5 13.5 L 14.5 13.5 M 3.5 7.5 L 6.5 7.5 L 8.5 9.5 L 8.5 11.5 M 8.5 9.5 L 10.5 7.5 L 14.5 7.5";
    // Path MTU: a pipe that narrows (45-degree shoulders).
    out property <string> mtu: "M 1.5 4.5 L 6.5 4.5 L 9.5 7.5 L 14.5 7.5 M 1.5 11.5 L 6.5 11.5 L 9.5 8.5 L 14.5 8.5";
}
