// The detail panel: the selected hop (the destination when nothing is selected), its latency
// over the last minutes, one plain sentence, its responders and the path's events.

import { ListView } from "std-widgets.slint";
import { Theme, Type, SectionLabel } from "@vibeware";
import { DetailInfo, ResponderRow, EventRow } from "types.slint";

// The chart's plot. Rust draws it in pixels of this box, so it reports its size.
component Plot inherits Rectangle {
    in property <DetailInfo> d;
    callback resized(length, length);
    changed width => { root.resized(self.width, self.height); }
    changed height => { root.resized(self.width, self.height); }
    init => { root.resized(self.width, self.height); }
    accessible-role: none;
    for layer[i] in [root.d.grid, root.d.range, root.d.avg, root.d.loss]: Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: layer;
        fill: i == 0 ? Theme.line : i == 1 ? Theme.line-strong : i == 2 ? Theme.accent : root.d.loss-real ? Theme.danger : Theme.ink-3;
    }
}

component Label inherits Text {
    font-family: Type.mono;
    font-size: Type.small;
    color: Theme.ink-3;
    accessible-role: none;
}

export component DetailPanel inherits Rectangle {
    in property <DetailInfo> d;
    in property <[ResponderRow]> responders;
    in property <string> responders-more;
    in property <[EventRow]> events;
    in property <string> events-title;
    callback chart-resized(length, length);

    // Nothing to show before the first hop answers: the table gets the room.
    height: root.d.shown ? 210px : 0px;
    visible: root.d.shown;
    background: Theme.bg;
    accessible-role: groupbox;
    accessible-label: "Detail";

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }

    if root.d.shown: VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 6px;
        // Who it is.
        HorizontalLayout {
            height: 18px;
            spacing: 10px;
            alignment: start;
            Text {
                text: root.d.title;
                font-size: Type.small;
                font-weight: Type.strong;
                color: Theme.ink;
                vertical-alignment: center;
            }
            if root.d.host != "": Text {
                text: root.d.host;
                font-size: Type.small;
                color: Theme.ink-2;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.d.addr;
                font-family: Type.mono;
                font-size: Type.small;
                color: Theme.ink-3;
                vertical-alignment: center;
            }
            if root.d.as-text != "": Text {
                text: root.d.as-text;
                font-family: Type.mono;
                font-size: Type.small;
                color: Theme.ink-3;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.d.mtu != "": Text {
                text: root.d.mtu;
                font-family: Type.mono;
                font-size: Type.small;
                color: Theme.ink-3;
                vertical-alignment: center;
            }
        }
        // What it means: up to two lines (a slow, rate-limiting router's verdict is two
        // sentences); top-aligned, so a one-line verdict sits where it always did.
        Text {
            height: 32px;
            text: root.d.verdict;
            font-size: Type.small;
            color: Theme.ink;
            wrap: word-wrap;
            vertical-alignment: top;
            overflow: elide;
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 20px;
            padding-top: 4px;
            // The chart: a labelled y scale, the plot, the time span under it.
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                Rectangle {
                    width: 46px;
                    Label {
                        x: 0;
                        y: root.d.y-top-at - 8px;
                        width: parent.width;
                        height: 16px;
                        text: root.d.y-top;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    Label {
                        x: 0;
                        y: root.d.y-mid-at - 8px;
                        width: parent.width;
                        height: 16px;
                        text: root.d.y-mid;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    plot := Plot {
                        vertical-stretch: 1;
                        d: root.d;
                        resized(w, h) => { root.chart-resized(w, h); }
                        if root.d.empty != "": Label {
                            text: root.d.empty;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                    HorizontalLayout {
                        height: 16px;
                        Label { text: root.d.x-left; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Label { text: root.d.x-left == "" ? "" : "now"; vertical-alignment: center; }
                    }
                }
            }
            // Who answered for this hop.
            VerticalLayout {
                width: 300px;
                spacing: 2px;
                SectionLabel { text: "RESPONDERS"; }
                for r in root.responders: Rectangle {
                    height: 20px;
                    accessible-role: list-item;
                    accessible-label: r.addr;
                    accessible-description: r.host + (r.host != "" ? ", " : "") + r.share + " of replies";
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: r.addr;
                            font-family: Type.mono;
                            font-size: Type.small;
                            color: r.primary ? Theme.ink : Theme.ink-2;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        Text {
                            text: r.host != "" ? r.host : r.as-text;
                            font-size: Type.small;
                            color: Theme.ink-3;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                            accessible-role: none;
                        }
                        Text {
                            text: r.share;
                            font-family: Type.mono;
                            font-size: Type.small;
                            color: Theme.ink-3;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                }
                if root.responders.length == 0: Text {
                    height: 20px;
                    text: "No replies yet";
                    font-size: Type.small;
                    color: Theme.ink-3;
                    vertical-alignment: center;
                }
                if root.responders-more != "": Text {
                    height: 20px;
                    text: root.responders-more;
                    font-size: Type.small;
                    color: Theme.ink-3;
                    vertical-alignment: center;
                }
                Rectangle { vertical-stretch: 1; }
            }
            // What happened on the way.
            VerticalLayout {
                width: 300px;
                spacing: 2px;
                SectionLabel { text: root.events-title; }
                if root.events.length > 0: ListView {
                    vertical-stretch: 1;
                    for e in root.events: Rectangle {
                        height: 20px;
                        accessible-role: list-item;
                        accessible-label: e.text;
                        accessible-description: e.time;
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: e.time;
                                font-family: Type.mono;
                                font-size: Type.small;
                                color: Theme.ink-3;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                            Text {
                                text: e.text;
                                font-size: Type.small;
                                color: e.danger ? Theme.danger-text : Theme.ink-2;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                                accessible-role: none;
                            }
                        }
                    }
                }
                if root.events.length == 0: VerticalLayout {
                    vertical-stretch: 1;
                    Text {
                        height: 20px;
                        text: "None so far";
                        font-size: Type.small;
                        color: Theme.ink-3;
                        vertical-alignment: center;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}
